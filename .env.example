# Public URL the site is served from, used for canonical URLs, sitemap and OG tags.
# Set it to the company subdomain once the CNAME is live, e.g. https://yatra.srivastavaroute.in
NEXT_PUBLIC_SITE_URL=https://www.example.com

# The company's dashboard / CRM endpoint. Every form submission is POSTed here as JSON.
# Leave empty for now: leads still reach the company on WhatsApp.
LEAD_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <value>" with every lead so the
# dashboard can ignore requests that didn't come from this site.
LEAD_WEBHOOK_SECRET=
